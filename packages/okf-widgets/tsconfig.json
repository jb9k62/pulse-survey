{
  "compilerOptions": {
    "target": "es2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "customConditions": ["source"],
    "types": ["vite/client"],
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "allowImportingTsExtensions": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    // The widgets run the app's own pure modules rather than a copy of them.
    "paths": {
      "@api/*": ["../../apps/api/src/*"],
      "@web/*": ["../../apps/web/src/*"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
