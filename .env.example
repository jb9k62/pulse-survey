# Copy to .env. These are local development values, not secrets.

# PostgreSQL in Docker Compose (compose.yaml)
POSTGRES_USER=pulse
POSTGRES_PASSWORD=pulse
POSTGRES_DB=pulse
POSTGRES_PORT=5432

# The owner runs migrations and the seed and owns the schema. The app role owns nothing
# and is subject to row-level security. See okf/adr/0005-rls-with-a-non-owner-app-role.md.
# Both passwords are the local Compose password; the roles are created by db/bootstrap.sql.
DATABASE_URL_OWNER=postgres://pulse_owner:pulse@127.0.0.1:5432/pulse
DATABASE_URL_APP=postgres://pulse_app:pulse@127.0.0.1:5432/pulse

# The e2e suite drops and recreates the schemas in this database before every run.
TEST_DATABASE_URL_OWNER=postgres://pulse_owner:pulse@127.0.0.1:5432/pulse_test
TEST_DATABASE_URL_APP=postgres://pulse_app:pulse@127.0.0.1:5432/pulse_test

# off (default): the dev routes are 404 and there is no way to sign in.
# dev: enables the seeded user picker. Needs NODE_ENV=development or test; any other value,
# or none, counts as production. `npm run dev:api` sets NODE_ENV=development itself.
# The API also refuses to start if the database grants disagree with this setting:
# `npm run db:seed` grants the dev sign-in functions to pulse_app when this is dev and revokes
# them when it is off; migrations never grant them. Re-run the seed after changing it.
AUTH_MODE=dev

# Session lifetime in hours.
SESSION_TTL_HOURS=12

# API port. Vite proxies /api to http://127.0.0.1:$API_PORT.
API_PORT=3000
